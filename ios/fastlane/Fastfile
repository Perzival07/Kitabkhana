# TestFlight upload for Kitabkhana.
#
#   cd ios && bundle install && bundle exec fastlane beta
#
# Authentication uses an App Store Connect API key (no Apple ID password, no
# 2FA prompts, works in CI). Create one at App Store Connect > Users and Access
# > Integrations > App Store Connect API (role: App Manager), then provide:
#
#   ASC_KEY_ID        the key's ID
#   ASC_ISSUER_ID     the issuer ID shown on that page
#   ASC_KEY_CONTENT   the .p8 file's contents, base64 encoded
#   APPLE_TEAM_ID     your developer team ID
#
# Never commit the .p8 file. Signing is automatic: xcodebuild creates and
# fetches certificates and profiles through that same API key.

default_platform(:ios)

platform :ios do
  desc "Build the production app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false,
    )

    # The build number must rise on every upload. CI passes its run number;
    # locally, ask TestFlight for the latest and add one.
    build_number = ENV["BUILD_NUMBER"] ||
      (latest_testflight_build_number(api_key: api_key, app_identifier: "com.kitabkhana.kitabkhana") + 1).to_s

    Dir.chdir("..") do
      sh("cd .. && flutter build ios --release --flavor prod -t lib/main_prod.dart --no-codesign --build-number=#{build_number}")
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "prod",
      configuration: "Release-prod",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      output_directory: "build",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
