<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied off the device: not to Google's cloud backup, and not to a
  new phone during setup. The library (database, covers, backups) is the
  reader's private data; they move it themselves with a .kitab backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
